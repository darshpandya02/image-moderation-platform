# Provided by `vercel env pull` once the Neon and Blob resources are connected:
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Reviewer login and cookie signing.
REVIEWER_PASSWORD=
SESSION_SECRET=

# Local development: run the worker in-process instead of via Vercel Queues.
QUEUE_DRIVER=inline

# Protects /api/cron/sweep (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Optional overrides (defaults shown).
UPLOAD_RATE_LIMIT=30
UPLOAD_RATE_WINDOW_SECONDS=600
